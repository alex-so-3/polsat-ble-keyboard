# Common defaults for the polsat-ble-keyboard project.
# Target is selected with `idf.py set-target esp32c3`.

# --- Bluetooth: BLE-only HID, using the NimBLE host (smaller than Bluedroid) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# NimBLE's built-in HID GATT service, used by the esp_hid device code.
CONFIG_BT_NIMBLE_HID_SERVICE=y
# Persist bonding keys in NVS so the host stays paired across reboots.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# GAP service (0x1800) characteristics that hosts read after connecting. Apple
# devices display this name (not the adv name) and route HID input by this
# appearance — must be a real name and Keyboard (0x03C1 = 961), or tvOS ignores it.
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="Polsat IR Kbd"
CONFIG_BT_NIMBLE_SVC_GAP_APPEARANCE=961
# Multi-device: Fn+F1..F4 switch between up to 4 bonded hosts (each on its own
# identity), so allow several simultaneous bonds.
CONFIG_BT_NIMBLE_MAX_BONDS=8
CONFIG_BT_NIMBLE_MAX_CCCDS=16
# The NimBLE host logs every GATT notify at INFO; we send a mouse report ~60x/s,
# so drop it to WARNING to keep the console (and the report cadence) clear.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# The BLE stack does not fit the default factory app partition.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Dev board has 4 MB of flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Keep the default log level at INFO so decoded keypresses are visible.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
